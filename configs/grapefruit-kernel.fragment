# Grapefruit OS — Linux kernel configuration fragment
#
# Apply this on top of a recent upstream or distribution kernel config
# (e.g. via scripts/kconfig/merge_config.sh or manual menuconfig).
#
# Goal: enable the features described in docs/kernel-features.md while
# keeping a practical, bootable general-purpose kernel.

# ------------------------------------------------------------
# Isolation & Containers (first-class)
# ------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

# ------------------------------------------------------------
# Security & Sandboxing
# ------------------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
# CONFIG_SECURITY_SELINUX is left to the integrator (optional stronger MAC)
# CONFIG_SECURITY_APPARMOR is left to the integrator
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# ------------------------------------------------------------
# Modern I/O & Performance
# ------------------------------------------------------------
CONFIG_IO_URING=y
CONFIG_IRQ_TIMINGS=y

# ------------------------------------------------------------
# eBPF (programmability, observability, policy)
# ------------------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_DEBUG_INFO_BTF=y

# ------------------------------------------------------------
# Memory & Addressing
# ------------------------------------------------------------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# ASLR / KASLR are typically on by default in modern configs; ensure they stay enabled

# ------------------------------------------------------------
# Hardware & Virtualization support (practical defaults)
# ------------------------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_IRQ_REMAP=y
# KVM and related options should be enabled on targets that need virtualization

# ------------------------------------------------------------
# Scheduler & Topology
# ------------------------------------------------------------
CONFIG_SCHED_SMT=y
CONFIG_NUMA=y
CONFIG_SCHED_CLUSTER=y

# End of Grapefruit fragment
# Review and merge carefully; some options depend on architecture and base config.
